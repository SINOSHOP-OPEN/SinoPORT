# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# ---- 测试与缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 大体积产物（不是源码，不入库）----
_build/
*.FCStd
*.FCStd1
*.step
*.stp
*.blend
*.blend1
output/
_frames*/
frames/

# ---- 视频与截图中间产物 ----
# 只屏蔽录屏/渲染中间产物；已交付成片若需入库请用 git add -f
recordings/
*_frames/
captions/*.mp4
*_sub.mp4

# ---- 录屏产物 ----
SINOPORT_take_*.mp4

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# ---- 本机配置（不要带令牌进仓库）----
.env
.env.local
*.key
*.pem

# ---- 归档（保留在本机，不入库）----
# 注：_archive/ 中存放**旧版本 README 等历史文档**，属于项目资产，
#     需要随仓库保留，故显式放行。仅 _archive/FCStd 与大体积产物才排除。
_archive/*.mp4
_archive/frames/
_archive/_frames*/
_archive/*.FCStd
_archive/*.blend
